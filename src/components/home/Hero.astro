---
import Button from '../primitives/Button.astro';
import { profile } from '../../data/profile';
---
<section class="hero">
  <div class="hero-inner hero-entrance">
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-discipline">{profile.tagline}</p>
    <p class="hero-areas" aria-hidden="true">GENAI &middot; AGENTS &middot; DATA &middot; SYSTEMS</p>
    <p class="hero-bio">{profile.bio}</p>
    <div class="hero-actions">
      <Button href={`${Astro.base}projects`} variant="primary">Explore My Work</Button>
      <Button href={`${Astro.base}about`} variant="outline">About</Button>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: calc(75vh - var(--layout-nav-height));
    padding-top: var(--space-2);
    padding-bottom: var(--space-6);
    position: relative;
  }

  .hero-inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Primary — the person's name */
  .hero-name {
    font-size: clamp(2.8rem, 7vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.0;
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-primary);
  }

  /* Secondary — professional discipline */
  .hero-discipline {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 var(--space-2) 0;
    letter-spacing: -0.01em;
  }

  /* Tertiary — domain tags */
  .hero-areas {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6) 0;
  }

  /* Bio copy */
  .hero-bio {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 auto var(--space-8) auto;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: var(--space-5);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0.3;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--color-text-muted), transparent);
    animation: scrollPulse 2.4s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(0.7); }
  }

  .hero-entrance {
    animation: heroFadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes heroFadeUp {
    0% { opacity: 0; transform: translateY(16px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line { animation: none; }
    .hero-scroll { display: none; }
    .hero-entrance { animation: none; opacity: 1; transform: none; }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: calc(90vh - var(--layout-nav-height));
      padding-top: var(--space-6);
    }
    .hero-name { font-size: 2.4rem; }
    .hero-bio { font-size: var(--text-base); }
    .hero-scroll { display: none; }
  }
</style>
