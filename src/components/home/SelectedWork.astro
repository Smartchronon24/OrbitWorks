---
import { getCollection } from 'astro:content';
import Button from '../primitives/Button.astro';

// Show featured projects; fall back to first 4 if nothing is flagged featured
const all = await getCollection('projects');
let featured = all.filter(p => p.data.featured);
if (featured.length === 0) featured = all.slice(0, 4);
// Cap at 4
featured = featured.slice(0, 4);
---
<section class="selected-work reveal">
  <div class="sw-header">
    <p class="sw-eyebrow">SELECTED WORK</p>
    <a href="/projects" class="sw-all">View all <span class="arrow" aria-hidden="true">→</span></a>
  </div>

  <div class="sw-grid">
    {featured.map((project, i) => (
      <a href={`/projects/${project.id}`} class="sw-card">
        <span class="sw-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="sw-title">{project.data.title}</h3>
        <p class="sw-desc">{project.data.shortDescription}</p>
        {project.data.status === 'Active' && (
          <span class="sw-active-badge">Active</span>
        )}
        <span class="sw-link" aria-hidden="true"><span class="arrow" aria-hidden="true">→</span> Case study</span>
      </a>
    ))}
  </div>
</section>

<style>
  .selected-work {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .sw-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .sw-eyebrow {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .sw-all {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-fast);
  }
  .sw-all:hover { color: var(--color-accent); }
  
  .sw-all .arrow {
    transition: transform var(--transition-fast);
  }
  
  .sw-all:hover .arrow {
    transform: translateX(3px);
  }

  .sw-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background-color: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .sw-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background-color: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--transition-fast);
    position: relative;
  }

  .sw-card:hover {
    background-color: var(--color-surface-hover);
  }

  .sw-card:hover .sw-link {
    color: var(--color-accent);
  }

  .sw-card:hover .sw-link .arrow {
    transform: translateX(3px);
  }

  .sw-index {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    opacity: 0.5;
    letter-spacing: 0.06em;
  }

  .sw-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.25;
  }

  .sw-tech {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin: 0;
  }

  .sw-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;
    line-height: 1.55;
  }

  .sw-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color var(--transition-fast);
  }

  .sw-link .arrow {
    transition: transform var(--transition-fast);
  }

  .sw-card:hover .sw-title {
    color: var(--color-text-primary);
  }

  .sw-active-badge {
    display: inline-block;
    font-size: 0.6rem;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent-subtle);
    background-color: var(--color-accent-subtle);
    border-radius: 9999px;
    padding: 1px 7px;
    width: fit-content;
  }

  @media (max-width: 768px) {
    .sw-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .selected-work { padding: var(--space-8) 0; }
    .sw-card { padding: var(--space-4); }
  }
</style>
