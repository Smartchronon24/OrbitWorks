---
import Button from '../primitives/Button.astro';
---
<section class="final-cta reveal">
  <div class="cta-inner">
    <p class="cta-eyebrow">THERE'S MORE</p>
    <h2 class="cta-heading">There's more to explore.</h2>
    <p class="cta-body">
      Projects, experiments, systems,<br class="cta-br" />
      and the decisions behind them.
    </p>
    <div class="cta-actions">
      <Button href="https://github.com/Smartchronon24/" variant="primary" target="_blank" rel="noopener noreferrer">GitHub ↗</Button>
      <Button href={`${Astro.base}resume`} variant="outline">View Resume</Button>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: var(--space-12) 0 var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .cta-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-eyebrow {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
  }

  .cta-heading {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
  }

  .cta-body {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 var(--space-6) 0;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .final-cta { padding: var(--space-8) 0; }
    .cta-heading { font-size: var(--text-2xl); }
    .cta-br { display: none; }
  }
</style>
