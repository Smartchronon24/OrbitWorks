---
import { profile } from '../data/profile';
---
<section class="about-hero" aria-labelledby="about-hero-title">
  <div class="about-hero-copy">
    <p class="profile-section-label">About</p>
    <h1 id="about-hero-title">Hello, I am {profile.name}.</h1>
    <p class="profile-bio">I am a Software &amp; AI Engineer specializing in production-grade LLM pipelines, agentic systems, and data orchestration. I bridge the gap between complex hardware systems and production-ready cloud architectures to build intelligent, data-driven applications.</p>
    <aside class="telemetry-ribbon" aria-label="Professional focus">
      <span>🎯 <strong>Focus:</strong> AI/ML &amp; Systems</span>
      <span>💼 <strong>Current:</strong> Engineering Intern</span>
      <span>📍 <strong>Location:</strong> Chennai, India</span>
    </aside>
  </div>
</section>

<style>
  .about-hero { margin-bottom: var(--space-12); text-align: center; }
  .about-hero-copy { min-width: 0; display: flex; flex-direction: column; align-items: center; }
  .profile-section-label { font-size: var(--text-xs); font-family: var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 var(--space-3) 0; }
  h1 { font-size: clamp(2.025rem, 4.5vw, 3.6rem); line-height: 1.05; letter-spacing: -0.04em; margin: 0 0 var(--space-5) 0; color: var(--color-text-primary); }
  .profile-bio { max-width: 680px; font-size: 1.1rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0; }
  .telemetry-ribbon { width: fit-content; max-width: 100%; margin-top: var(--space-6); display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: clamp(1.25rem, 3vw, 2.5rem); row-gap: var(--space-3); padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); box-shadow: 0 12px 32px color-mix(in srgb, var(--color-text-primary) 10%, transparent); color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.5; text-align: left; box-sizing: border-box; }
  .telemetry-ribbon span { display: block; white-space: nowrap; }
  .telemetry-ribbon strong { color: var(--color-text-primary); font-weight: 600; }
  @media (max-width: 768px) {
    .telemetry-ribbon { width: 100%; column-gap: var(--space-4); }
    .telemetry-ribbon span { white-space: normal; }
  }
</style>
