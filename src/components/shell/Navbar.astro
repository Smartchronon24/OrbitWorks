---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---
<header class="navbar">
  <div class="container navbar-inner">
    <a href="/OrbitWorks/" class="brand" aria-label="Home">
      <span class="name">NAVANETH ANAND</span>
      <span class="site-id">ORBIT WORKS</span>
    </a>

    <button
      class="mobile-menu-toggle"
      type="button"
      data-mobile-menu-toggle
      aria-controls="primary-navigation"
      aria-expanded="false"
      aria-label="Open navigation menu"
    >
      <span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>

    <nav id="primary-navigation" aria-label="Primary navigation">
      <ul class="nav-links">
        <li>
          <a href="/OrbitWorks/projects" aria-current={isCurrent('/projects') ? 'page' : undefined}>Work</a>
        </li>
        <li>
          <a href="/OrbitWorks/experience" aria-current={isCurrent('/experience') ? 'page' : undefined}>Experience</a>
        </li>
        <li>
          <a href="/OrbitWorks/about" aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
        </li>
        <li>
          <a href="/OrbitWorks/resume" aria-current={isCurrent('/resume') ? 'page' : undefined}>Resume</a>
        </li>
        <li>
          <button
            class="ai-workspace-toggle"
            type="button"
            data-ai-toggle
            aria-controls="ai-workspace-panel"
            aria-expanded="false"
            aria-label="Open OrbitWorks-AI workspace"
          ><span>Ask <strong>me</strong></span></button>
        </li>
      </ul>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    height: var(--layout-nav-height);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .navbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    gap: 1px;
    padding: 0.3rem 0.5rem;
    border: 1.4px solid transparent;
    border-radius: 6px;
    background:
      linear-gradient(var(--color-bg), var(--color-bg)) padding-box,
      linear-gradient(115deg, #7f8790 0%, #c3c8ce 20%, #929aa3 42%, #edf0f2 58%, #a0a7af 78%, #737b84 100%) border-box;
    background-size: auto, 240% 240%;
    box-shadow: 0 0 0 0.7px rgba(112, 120, 129, 0.3), 0 0 10px rgba(148, 154, 161, 0.2);
    transform: scale(1.05);
    transform-origin: left center;
    animation: brand-silver-shine 6s ease-in-out infinite;
    transition: opacity var(--transition-fast), box-shadow var(--transition-fast);
  }

  .brand:hover {
    opacity: 1;
    box-shadow: 0 0 0 0.7px rgba(112, 120, 129, 0.42), 0 0 14px rgba(148, 154, 161, 0.32);
  }

  @keyframes brand-silver-shine {
    0%, 100% { background-position: 0 0, 0% 50%; }
    50% { background-position: 0 0, 100% 50%; }
  }

  .name {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .site-id {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
  }

  .nav-links {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.36rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 5px;
    background: var(--color-surface);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-links a:hover,
  .nav-links a[aria-current="page"] {
    border-color: var(--color-text-muted);
    background: var(--color-surface-hover);
    color: var(--color-text-primary);
  }

  .nav-links .ai-workspace-toggle {
    position: relative;
    isolation: isolate;
    min-height: 2.36rem;
    padding: 0.35rem 0.65rem;
    border: 2px solid transparent;
    border-radius: 5px;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      linear-gradient(115deg, #64748b 0%, #cbd5e1 16%, #8b5cf6 38%, #0891b2 58%, #db2777 78%, #64748b 100%) border-box;
    background-size: auto, 220% 220%;
    box-shadow: 0 0 0 1px rgba(100, 116, 139, 0.16);
    color: var(--color-text-secondary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    animation: ai-silver-spectrum 8s ease-in-out infinite;
    transition: color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .nav-links .ai-workspace-toggle:hover,
  .nav-links .ai-workspace-toggle[aria-expanded="true"] {
    color: var(--color-text-primary);
    box-shadow: 0 0 0 1px rgba(100, 116, 139, 0.28), 0 0 14px rgba(8, 145, 178, 0.2), 0 0 18px rgba(139, 92, 246, 0.14);
  }

  @keyframes ai-silver-spectrum {
    0%, 100% { background-position: 0 0, 0% 50%; }
    50% { background-position: 0 0, 100% 50%; }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .mobile-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .menu-icon {
    display: grid;
    gap: 4px;
  }

  .menu-icon i {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
  }

  .mobile-menu-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .navbar-inner {
      justify-content: flex-start;
      gap: var(--space-2);
    }

    .brand {
      margin-right: auto;
      transform: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
      flex: 0 0 auto;
    }

    .nav-actions {
      flex: 0 0 auto;
    }

    .nav-actions :global(.theme-toggle) {
      width: 44px;
      height: 44px;
    }

    .navbar-inner > nav {
      position: absolute;
      z-index: 101;
      top: 100%;
      right: 0;
      left: 0;
      display: none;
      padding: var(--space-3);
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
      box-shadow: 0 12px 24px -20px var(--color-text-primary);
    }

    .navbar:has(.mobile-menu-toggle[aria-expanded="true"]) .navbar-inner > nav {
      display: block;
    }

    .nav-links {
      flex-direction: column;
      gap: var(--space-2);
    }

    .nav-links li,
    .nav-links a,
    .nav-links .ai-workspace-toggle {
      width: 100%;
    }

    .nav-links a,
    .nav-links .ai-workspace-toggle {
      min-height: 44px;
      justify-content: flex-start;
      padding: 0.55rem 0.75rem;
      font-size: var(--text-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links a,
    .nav-links .ai-workspace-toggle,
    .brand { transition: none; }
    .nav-links .ai-workspace-toggle { animation: none; }
    .brand { animation: none; }
  }
</style>

<script>
  const closeMobileMenu = (header: HTMLElement) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation menu');
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const toggle = target.closest<HTMLButtonElement>('[data-mobile-menu-toggle]');
    if (toggle) {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', `${open ? 'Close' : 'Open'} navigation menu`);
      return;
    }

    const header = target.closest<HTMLElement>('.navbar');
    if (!header || target.closest('#primary-navigation a, #primary-navigation button')) {
      document.querySelectorAll<HTMLElement>('.navbar').forEach(closeMobileMenu);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.navbar').forEach((header) => {
      const toggle = header.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      if (toggle?.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu(header);
        toggle.focus();
      }
    });
  });
</script>