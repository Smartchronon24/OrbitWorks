---
import { capabilities } from '../data/capabilities';
---
<section class="build-capabilities">
  <h2 class="section-title" id="what-i-build">What I Build</h2>
  <div class="capability-grid">
    {capabilities.map(cap => (
      <div class="capability-card" key={cap.title}>
        <div class="cap-icon">{cap.icon}</div>
        <h3 class="cap-title">{cap.title}</h3>
        <p class="cap-desc">{cap.description}</p>
        <div class="cap-evidence">
          {cap.evidence.map(item => (
            <span class="evidence-item" key={item}>{item}</span>
          ))}
        </div>
      </div>
    ))}  
  </div>
</section>

<style>
  .build-capabilities { margin: var(--space-6) 0; }
  .build-capabilities .section-title { color: var(--color-text-primary); }
  .capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
  .capability-card { height: 100%; box-sizing: border-box; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: var(--space-5); text-align: left; }
  .cap-icon { font-size: var(--text-lg); margin: 0 0 var(--space-2) 0; color: var(--color-accent); }
  .cap-title { font-size: var(--text-lg); font-weight: 600; margin: 0 0 var(--space-2) 0; color: var(--color-text-primary); }
  .cap-desc { font-size: var(--text-sm); color: var(--color-text-secondary); margin: 0 0 var(--space-3) 0; }
  .cap-evidence { display: flex; flex-wrap: wrap; gap: var(--space-2); font-size: var(--text-xs); color: var(--color-text-muted); }
  .evidence-item::after { content: ", "; }
  .evidence-item:last-child::after { content: ""; }
  @media (max-width: 600px) { .capability-grid { grid-template-columns: 1fr; } }
</style>
