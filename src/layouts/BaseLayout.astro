---
import Navbar from '../components/shell/Navbar.astro';
import Footer from '../components/shell/Footer.astro';
import QuietSpace from '../components/QuietSpace.astro';
import AIChat from '../components/ai/AIChat.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={site.author} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/OrbitWorks/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/OrbitWorks/favicon.ico" />
  <ClientRouter />
  <!-- Prevent flash of unstyled theme -->
  <script is:inline>
    (function() {
      var stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
      var theme = (stored === 'dark' || stored === 'light')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <QuietSpace />
  <Navbar />
  <div class="workspace-shell">
    <div class="workspace-content">
      <main class="container page-main">
        <slot />
      </main>
      <Footer />
    </div>
    <aside
      id="ai-workspace-panel"
      class="workspace-panel"
      data-open="false"
      aria-label="OrbitWorks-AI workspace"
      aria-hidden="true"
      inert
      transition:persist="orbitworks-ai"
    >
      <div
        class="workspace-resize-handle"
        data-workspace-resize
        role="separator"
        aria-label="Resize OrbitWorks-AI workspace"
        aria-orientation="vertical"
        aria-controls="ai-workspace-panel"
        aria-valuemin="280"
        aria-valuemax="400"
        aria-valuenow="360"
        tabindex="0"
      ></div>
      <AIChat />
    </aside>
  </div>

  <script>
    import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

    let revealObserver: IntersectionObserver | undefined;
    const observeReveals = () => {
      revealObserver?.disconnect();
      revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver?.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -20px 0px' });

      document.querySelectorAll('.reveal:not(.is-visible)').forEach(el => revealObserver?.observe(el));
    };

    observeReveals();
    document.addEventListener('astro:page-load', observeReveals);

    document.addEventListener('astro:before-swap', (event: TransitionBeforeSwapEvent) => {
      document.documentElement.classList.add('ai-workspace-navigating');
      event.newDocument.documentElement.classList.add('ai-workspace-navigating');
      event.newDocument.documentElement.style.setProperty('--ai-panel-width', `${panelWidth}px`);
    });

    const panel = document.getElementById('ai-workspace-panel');
    const resizeHandle = panel?.querySelector<HTMLElement>('[data-workspace-resize]');
    const minPanelWidth = 280;
    const defaultPanelWidth = 360;
    const storedPanelWidth = Number(localStorage.getItem('ai-workspace-width'));
    let panelWidth = Number.isFinite(storedPanelWidth) && storedPanelWidth > 0
      ? storedPanelWidth
      : defaultPanelWidth;
    const maxPanelWidth = () => Math.floor(window.innerWidth / 2);
    const updatePanelWidth = (width: number) => {
      if (!panel || !resizeHandle) return;
      panelWidth = Math.round(Math.min(
        maxPanelWidth(),
        Math.max(Math.min(minPanelWidth, maxPanelWidth()), width)
      ));
      document.documentElement.style.setProperty('--ai-panel-width', `${panelWidth}px`);
      localStorage.setItem('ai-workspace-width', String(panelWidth));
      resizeHandle.setAttribute('aria-valuemax', String(maxPanelWidth()));
      resizeHandle.setAttribute('aria-valuenow', String(panelWidth));
    };

    if (panel && resizeHandle) {
      updatePanelWidth(panelWidth);

      resizeHandle.addEventListener('pointerdown', (event) => {
        if (window.matchMedia('(max-width: 900px)').matches) return;
        event.preventDefault();
        panel?.parentElement?.classList.add('is-resizing');
        resizeHandle.setPointerCapture(event.pointerId);

        const resize = (moveEvent: PointerEvent) => {
          updatePanelWidth(panel.getBoundingClientRect().right - moveEvent.clientX);
        };
        const finishResize = (upEvent: PointerEvent) => {
          resizeHandle.removeEventListener('pointermove', resize);
          resizeHandle.removeEventListener('pointerup', finishResize);
          resizeHandle.removeEventListener('pointercancel', finishResize);
          panel?.parentElement?.classList.remove('is-resizing');
          if (resizeHandle.hasPointerCapture(upEvent.pointerId)) {
            resizeHandle.releasePointerCapture(upEvent.pointerId);
          }
        };

        resizeHandle.addEventListener('pointermove', resize);
        resizeHandle.addEventListener('pointerup', finishResize);
        resizeHandle.addEventListener('pointercancel', finishResize);
      });

      resizeHandle.addEventListener('keydown', (event) => {
        const currentWidth = Number(resizeHandle.getAttribute('aria-valuenow'));
        const step = event.shiftKey ? 40 : 20;
        if (event.key === 'ArrowLeft') updatePanelWidth(currentWidth + step);
        else if (event.key === 'ArrowRight') updatePanelWidth(currentWidth - step);
        else if (event.key === 'Home') updatePanelWidth(Math.min(minPanelWidth, maxPanelWidth()));
        else if (event.key === 'End') updatePanelWidth(maxPanelWidth());
        else return;
        event.preventDefault();
      });

      window.addEventListener('resize', () => {
        updatePanelWidth(panelWidth);
      });

      document.addEventListener('astro:page-load', () => updatePanelWidth(panelWidth));
    }

    const setWorkspaceOpen = (open: boolean, restoreFocus = true) => {
      if (!panel) return;
      document.documentElement.classList.toggle('ai-workspace-open', open);
      panel.dataset.open = String(open);
      panel.setAttribute('aria-hidden', String(!open));
      panel.inert = !open;
      document.querySelectorAll<HTMLButtonElement>('[data-ai-toggle]').forEach((button) => {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', `${open ? 'Close' : 'Open'} OrbitWorks-AI workspace`);
      });

      if (open) {
        panel.querySelector<HTMLButtonElement>('[data-ai-close]')?.focus();
      } else if (restoreFocus) {
        document.querySelector<HTMLButtonElement>('[data-ai-toggle]')?.focus();
      }
    };

    const syncWorkspaceState = () => {
      if (!panel) return;
      updatePanelWidth(panelWidth);
      const open = panel.dataset.open === 'true';
      document.documentElement.classList.toggle('ai-workspace-open', open);
      panel.setAttribute('aria-hidden', String(!open));
      panel.inert = !open;
      document.querySelectorAll<HTMLButtonElement>('[data-ai-toggle]').forEach((button) => {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', `${open ? 'Close' : 'Open'} OrbitWorks-AI workspace`);
      });
    };

    syncWorkspaceState();
    document.addEventListener('astro:page-load', syncWorkspaceState);
    document.addEventListener('astro:page-load', () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('ai-workspace-navigating');
        });
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-ai-toggle]')) {
        setWorkspaceOpen(!document.documentElement.classList.contains('ai-workspace-open'));
      } else if (target.closest('[data-ai-close]')) {
        setWorkspaceOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.documentElement.classList.contains('ai-workspace-open')) {
        setWorkspaceOpen(false);
      }
    });
  </script>
</body>
</html>

<style>
  :global(:root) {
    --ai-panel-width: min(360px, 50vw);
  }

  .workspace-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0fr;
    align-items: start;
    gap: 0;
    width: min(100%, 1520px);
    margin: 0 auto;
    padding: 0 var(--space-4);
    transition: grid-template-columns 280ms ease, gap 280ms ease;
  }

  .workspace-shell.is-resizing,
  :global(html.ai-workspace-navigating) .workspace-shell {
    transition: none;
  }

  .workspace-content {
    min-width: 0;
  }

  .workspace-panel {
    position: sticky;
    top: calc(var(--layout-nav-height) + var(--space-5));
    min-width: 0;
    width: 0;
    height: calc(100dvh - var(--layout-nav-height) - var(--space-4));
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    border: 0 solid var(--color-border);
    border-radius: 12px;
    background-color: var(--color-canvas-bg);
    transition: opacity 200ms ease, visibility 0s linear 280ms;
  }

  :global(html.ai-workspace-navigating .workspace-panel) {
    transition: none !important;
  }

  :global(.workspace-shell:has(> #ai-workspace-panel[data-open="true"])) {
    grid-template-columns: minmax(0, 1fr) minmax(min(280px, 50vw), min(var(--ai-panel-width), 50vw));
    gap: var(--space-3);
  }

  :global(.workspace-shell:has(> #ai-workspace-panel[data-open="true"])) .workspace-panel {
    position: sticky;
    width: auto;
    padding-left: 10px;
    visibility: visible;
    opacity: 1;
    border-width: 1px;
    transition: opacity 200ms ease, visibility 0s;
  }

  .workspace-resize-handle {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 0;
    width: 10px;
    border-radius: 12px 0 0 12px;
    cursor: col-resize;
    touch-action: none;
  }

  .workspace-resize-handle::after {
    position: absolute;
    top: 50%;
    left: 3px;
    width: 3px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-border);
    content: '';
    transform: translateY(-50%);
    transition: background-color var(--transition-fast), height var(--transition-fast);
  }

  .workspace-resize-handle:hover::after,
  .workspace-resize-handle:focus-visible::after {
    height: 48px;
    background: var(--color-accent);
  }

  .workspace-resize-handle:focus-visible {
    outline: none;
  }

  .page-main {
    min-height: calc(100vh - var(--layout-nav-height) - 160px);
    margin-top: var(--space-5);
    margin-bottom: var(--space-8);
    padding: var(--space-8);
    position: relative;

    /* Multi-layered background: diffuse ambient illumination + matte surface base */
    background-image: var(--color-canvas-glow);
    background-color: var(--color-canvas-bg);
    border: 1px solid var(--color-border);
    border-radius: 16px;

    /* Soft inset illumination + ambient drop shadow */
    box-shadow: var(--color-canvas-inset), var(--color-canvas-shadow);

    /* Matte frosted material diffusion for background stars */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    transition: background-color var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  @media (max-width: 900px) {
    :global(html.ai-workspace-open) {
      overflow: hidden;
    }

    .workspace-shell,
    :global(.workspace-shell:has(> #ai-workspace-panel[data-open="true"])) {
      display: block;
      width: 100%;
      padding: 0 var(--space-3);
    }

    .workspace-panel,
    :global(.workspace-shell:has(> #ai-workspace-panel[data-open="true"])) .workspace-panel {
      position: fixed;
      z-index: 90;
      inset: var(--layout-nav-height) 0 0;
      width: auto;
      height: auto;
      padding-left: 0;
      padding: var(--space-2) var(--space-3) var(--space-3);
      border: 0;
      border-radius: 0;
      background: var(--color-bg);
      transform: translateX(100%);
      visibility: hidden;
      opacity: 0;
      transition: transform 280ms ease, opacity 200ms ease, visibility 0s linear 280ms;
      overflow: hidden;
      overscroll-behavior: contain;
    }

    :global(.workspace-shell:has(> #ai-workspace-panel[data-open="true"])) .workspace-panel {
      transform: translateX(0);
      visibility: visible;
      opacity: 1;
      border-top: 1px solid var(--color-border);
      transition: transform 280ms ease, opacity 200ms ease, visibility 0s;
    }

    .workspace-resize-handle {
      display: none;
    }

    .page-main {
      margin-top: var(--space-3);
      margin-bottom: var(--space-5);
      padding: var(--space-5) var(--space-4);
      border-radius: 12px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .workspace-shell,
    .workspace-panel {
      transition: none !important;
    }
  }
</style>