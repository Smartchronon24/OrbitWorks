---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { skills } from '../data/skills';
import { education } from '../data/education';
import { certifications } from '../data/certifications';
import ProfileSummary from '../components/ProfileSummary.astro';
import BuildCapabilities from '../components/BuildCapabilities.astro';
import TechnicalToolkit from '../components/TechnicalToolkit.astro';
import EducationCard from '../components/EducationCard.astro';
import CertificationRail from '../components/CertificationRail.astro';
import BeyondEngineering from '../components/BeyondEngineering.astro';
import EngineeringJourney from '../components/home/EngineeringJourney.astro';
---
<BaseLayout title="About — Navaneth Anand">
  <article class="about-page">
  <ProfileSummary />
  <EducationCard />
  <EngineeringJourney />
  <BuildCapabilities />
  <TechnicalToolkit />
  <CertificationRail />
  <BeyondEngineering />
</article>
</BaseLayout>

<style>
  .about-page {
    max-width: 820px;
    margin: 0 auto;
    padding-bottom: var(--space-12);
    text-align: center;
  }

  .about-header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  .about-name {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-2) 0;
    color: var(--color-text-primary);
    line-height: 1.0;
  }

  .about-discipline {
    font-size: var(--text-lg);
    color: var(--color-accent);
    margin: 0;
    font-weight: 500;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .about-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-title {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
    font-weight: 500;
  }

  .intro-section {
    gap: var(--space-5);
  }

  .bio-lead {
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin: 0;
    letter-spacing: -0.01em;
  }

  p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .bullet-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bullet-list strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* ── Toolkit Grid ── */
  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: var(--space-6);
  }

  .toolkit-category {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
  }

  .toolkit-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  /* ── Dual Section (Edu & Certs) ── */
  .dual-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-10);
  }

  /* Education */
  .edu-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .edu-degree {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .edu-inst {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin: 0 0 var(--space-1) 0;
  }

  .edu-meta {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  /* Certifications */
  .cert-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cert-category {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
  }

  .cert-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cert-items li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cert-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .dual-section {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }

  @media (max-width: 600px) {
    .about-page { padding-bottom: var(--space-8); }
    .page-title { font-size: var(--text-3xl); }
    .bio-lead { font-size: var(--text-xl); }
    .toolkit-grid { padding: var(--space-5); gap: var(--space-5); }
  }
</style>