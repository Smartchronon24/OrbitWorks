---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience } from '../data/experience';
import Badge from '../components/primitives/Badge.astro';
---
<BaseLayout title="Experience — Navaneth Anand">
  <section class="experience-page">
    <header class="page-header">
      <h1 class="page-title">Experience</h1>
      <p class="page-lead">Engineering systems, from hardware to AI models.</p>
    </header>

    <div class="exp-timeline">
      {experience.map(job => (
        <div class:list={['exp-node', 'reveal']}>
          <div class="exp-marker" aria-hidden="true"></div>
          
          <div class="exp-content">
            <div class="exp-meta">
              <span class="exp-dates">{job.dates}</span>
            </div>
            
            <div class="exp-header-main">
              <h2 class="exp-role">{job.role}</h2>
              <span class="exp-company">{job.company}</span>
            </div>
            
            <p class="exp-desc">{job.description}</p>
            
            {job.tags && job.tags.length > 0 && (
              <div class="exp-tags">
                {job.tags.map(tag => (
                  <Badge text={tag} />
                ))}
              </div>
            )}
            
            {job.relatedProjects && job.relatedProjects.length > 0 && (
              <div class="exp-projects">
                <p class="exp-projects-label">Related Work</p>
                <ul class="exp-projects-list">
                  {job.relatedProjects.map(proj => (
                    <li>
                      <a href={`/projects/${proj.slug}`} class="exp-project-link">
                        {proj.label} <span class="arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .experience-page {
    max-width: 820px;
    margin: 0 auto;
    padding-bottom: var(--space-12);
  }

  .page-header {
    margin-bottom: var(--space-12);
    text-align: center;
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-3) 0;
    color: var(--color-text-primary);
  }

  .page-lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Timeline ── */
  .exp-timeline {
    position: relative;
    padding-left: var(--space-6);
  }

  .exp-timeline::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 0;
    left: 4px;
    width: 1px;
    background: linear-gradient(to bottom, var(--color-border), transparent);
  }

  .exp-node {
    position: relative;
    margin-bottom: var(--space-12);
  }

  .exp-node:last-child {
    margin-bottom: 0;
  }

  .exp-marker {
    position: absolute;
    top: 6px;
    left: calc(-1 * var(--space-6) + 4px);
    width: 9px;
    height: 9px;
    background-color: var(--color-bg);
    border: 1.5px solid var(--color-accent);
    border-radius: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .exp-meta {
    margin-bottom: var(--space-2);
  }

  .exp-dates {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .exp-header-main {
    margin-bottom: var(--space-4);
  }

  .exp-role {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
    line-height: 1.2;
  }

  .exp-company {
    font-size: var(--text-base);
    color: var(--color-accent);
    font-weight: 500;
  }

  .exp-desc {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-5) 0;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  /* ── Related Projects ── */
  .exp-projects {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: var(--space-4) var(--space-5);
  }

  .exp-projects-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3) 0;
    text-transform: uppercase;
  }

  .exp-projects-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .exp-project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .exp-project-link:hover {
    color: var(--color-accent);
  }

  .exp-project-link .arrow {
    font-size: 0.9em;
    opacity: 0.5;
    transition: transform var(--transition-fast);
  }

  .exp-project-link:hover .arrow {
    transform: translateX(3px);
    opacity: 1;
  }

  @media (max-width: 600px) {
    .experience-page { padding-bottom: var(--space-8); }
    .exp-timeline { padding-left: var(--space-5); }
    .exp-marker { left: calc(-1 * var(--space-5) + 4px); }
    .page-title { font-size: var(--text-3xl); }
    .exp-role { font-size: var(--text-xl); }
  }
</style>